{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMicrovmBuildArtifact",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_ARTIFACT_BUCKET/gte-multilingual-base/*"
    },
    {
      "Sid": "WriteMicrovmLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-west-1:REPLACE_WITH_AWS_ACCOUNT_ID:log-group:/aws/lambda/microvms/any-embedding-gte-multilingual-base:*"
    }
  ]
}
