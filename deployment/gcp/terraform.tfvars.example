project_id     = "your-gcp-project-id"
region         = "us-central1"
api_key        = "CHANGE-ME-to-a-strong-random-key"
gateway_image  = "us-central1-docker.pkg.dev/your-gcp-project-id/any-embedding/gateway:latest"
image_registry = "us-central1-docker.pkg.dev/your-gcp-project-id/any-embedding/worker"
cloud_run_deletion_protection = false
tfstate_bucket = "your-gcp-project-id-tfstate"
alert_email    = "your-team@example.com"

# Scale to zero; no reserved warm gateway or worker instances.
gateway_min_instances = 0
worker_min_instances  = 0
# Gateway auth + worker deadline: leave headroom below the consumer timeout.
# worker_timeout_seconds = 120

# Worker shape defaults; per-model cpu/memory/concurrency in config.yaml override.
# worker_cpu         = "4"
# worker_memory      = "8Gi"
# worker_concurrency = 4
# Cloud Run execution environment (GPU workers are always GEN2).
# worker_execution_environment  = "EXECUTION_ENVIRONMENT_GEN2"
# gateway_execution_environment = "EXECUTION_ENVIRONMENT_GEN1"
# Per-client-IP requests per minute at the public edge.
# gateway_rate_limit_rpm = 3000
