# syntax=docker/dockerfile:1
FROM python:3.12-slim

WORKDIR /app

# UV_HTTP_TIMEOUT: multi-hundred-MB CUDA/torch wheels exceed uv's 30 s default on a busy link.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_HTTP_TIMEOUT=300

COPY --from=ghcr.io/astral-sh/uv:0.12.8 /uv /usr/local/bin/uv

# Installing from pyproject.toml resolves the extra without building the project.
COPY pyproject.toml ./
RUN uv pip install -r pyproject.toml --extra gateway

COPY app/__init__.py ./app/__init__.py
COPY app/gcp/__init__.py app/gcp/gateway.py ./app/gcp/
COPY app/shared ./app/shared
COPY config.yaml ./
RUN python -m compileall -q /app/app

RUN addgroup --system app && adduser --system --ingroup app app
USER app

ENV API_KEY=""
ENV CONFIG_PATH="config.yaml"

EXPOSE 8080

CMD ["uvicorn", "app.gcp.gateway:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log", "--no-server-header", "--timeout-keep-alive", "75"]
