FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --no-cache-dir ".[gateway]"

COPY app/ ./app/
COPY config.yaml ./

RUN addgroup --system app && adduser --system --ingroup app app
USER app

ENV API_KEY=""
ENV CONFIG_PATH="config.yaml"

EXPOSE 8080

CMD ["uvicorn", "app.gateway:app", "--host", "0.0.0.0", "--port", "8080"]
