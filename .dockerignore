# Caches and build artifacts at any depth (patterns without **/ only match the context root)
**/__pycache__
**/*.py[co]
**/node_modules
**/dist
**/build
**/*.egg-info
.venv/
.direnv/
.DS_Store

# Not part of any Google Cloud image
app/aws/
.git
.github
.codacy
tests/
deployment/
*.md
docker-compose.yaml
uv.lock
mise.toml
main.py
test.sh
generate_compose.py

# Secrets and local credentials
.env
.env.*
.envrc
.aws/
.gcloud/
.secrets/
.credentials/
**/application_default_credentials.json
**/*service-account-key*.json
**/*service-account-credentials*.json
*.key
*.pem
*.p12
*.pfx

# Terraform state
**/.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
