# syntax=docker/dockerfile:1
# Stage 1: Download model weights (HF_TOKEN mounted as BuildKit secret, never persisted in layers)
FROM python:3.12-slim AS model-downloader

WORKDIR /app
COPY pyproject.toml ./
RUN pip install --no-cache-dir ".[worker]"

ARG SENTENCE_TRANSFORMERS_VERSION=""
ARG TRANSFORMERS_VERSION=""
RUN if [ -n "$SENTENCE_TRANSFORMERS_VERSION" ]; then pip install --no-cache-dir "sentence-transformers==$SENTENCE_TRANSFORMERS_VERSION"; fi && \
    if [ -n "$TRANSFORMERS_VERSION" ]; then pip install --no-cache-dir "transformers==$TRANSFORMERS_VERSION"; fi

COPY app/ ./app/

ARG MODEL_NAME=""
ENV HF_HOME=/app/models
ENV MODEL_PATH=/app/model
RUN --mount=type=secret,id=HF_TOKEN \
    mkdir -p /app/models && python app/gcp/download_model.py

# Stage 2: Runtime image (no secrets baked in)
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --no-cache-dir ".[worker]"

# Optional: pin transformers version for models with compat issues (e.g. Jina v2)
ARG SENTENCE_TRANSFORMERS_VERSION=""
ARG TRANSFORMERS_VERSION=""
RUN if [ -n "$SENTENCE_TRANSFORMERS_VERSION" ]; then pip install --no-cache-dir "sentence-transformers==$SENTENCE_TRANSFORMERS_VERSION"; fi && \
    if [ -n "$TRANSFORMERS_VERSION" ]; then pip install --no-cache-dir "transformers==$TRANSFORMERS_VERSION"; fi

COPY app/ ./app/
COPY config.yaml ./

COPY --from=model-downloader /app/model /app/model

ARG MODEL_NAME=""
ENV MODEL_NAME=${MODEL_NAME}
ENV MODEL_TYPE="text"
ENV HF_HOME=/app/models
ENV MODEL_PATH=/app/model
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

RUN addgroup --system app && adduser --system --ingroup app app && chown -R app:app /app/model
USER app

EXPOSE 8080

CMD ["uvicorn", "app.gcp.worker:app", "--host", "0.0.0.0", "--port", "8080"]
